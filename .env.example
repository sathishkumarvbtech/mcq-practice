# ==============================================================================
# Python MCQ Arena - SMTP Email Configuration
# ==============================================================================
# Configure the settings below to enable sending quiz results directly to email.
# Copy this file to .env.local and update with your SMTP credentials.

# Destination email for all final quiz submissions
RESULT_RECIPIENT_EMAIL=sk1420000@gmail.com

# SMTP Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailtrap.io, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL/TLS, 25 for unencrypted)
SMTP_PORT=587

# SMTP Secure (true for port 465 SSL, false for port 587 STARTTLS)
SMTP_SECURE=false

# SMTP Username / Sender Email
SMTP_USER=your-email@gmail.com

# SMTP Password or App Password (For Gmail: Use 16-character Google App Password)
SMTP_PASS=your-app-password

# Email 'From' header
SMTP_FROM="Python MCQ Arena <noreply@mcqarena.com>"

# Log email sending details in terminal
DEBUG_EMAIL=true
